{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.backend.tsbuildinfo"
  },
  "include": [
    "agent/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/backend/**/*.ts"
  ]
}
